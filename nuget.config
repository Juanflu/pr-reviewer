<?xml version="1.0" encoding="utf-8"?>
<!-- El exportador no usa paquetes NuGet: solo nuget.org, para que la restauración no consulte
     feeds privados configurados a nivel de usuario (que pueden fallar con 401 y ralentizarla). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
